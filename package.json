{
  "name": "dsh-context-control",
  "version": "0.4.4",
  "type": "module",
  "description": "会话级 MCP/技能可见性门控：新会话默认精简（官方条目开、用户配置的关），对话中通过模型工具或输入框面板按需开启；开关状态按项目持久化，并自带在线升级检查与一键升级。",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./update": "./update.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "update.js",
    "respawn.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "context-control",
    "mcp",
    "skill",
    "self-update"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zp96324511/dsh-context-control.git"
  },
  "homepage": "https://github.com/zp96324511/dsh-context-control#readme",
  "bugs": {
    "url": "https://github.com/zp96324511/dsh-context-control/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node scripts/check-manifest.mjs && node --check index.js && node --check update.js && node --check respawn.cjs && node --check client.js && npm run test",
    "test": "node --test test/update.test.mjs && node test/client-harness.cjs ./client.js",
    "channel": "node scripts/publish-channel.mjs",
    "channel:serve": "node scripts/serve-channel.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
